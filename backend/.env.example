# ─── Base de Datos PostgreSQL ──────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:tu_password@localhost:5432/planilla_docentes_upds
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:tu_password@localhost:5432/planilla_docentes_upds

# ─── Runtime mode ──────────────────────────────────────────
# Production must use APP_ENV=production and AUTO_SCHEMA_BOOTSTRAP=false.
# Run Alembic separately before starting the API in production.
APP_ENV=development
AUTO_SCHEMA_BOOTSTRAP=true

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── JWT ───────────────────────────────────────────────────
# Development-only example. Production requires 32 random bytes (64 hex
# characters); follow deploy/.env.production.example and DEPLOYMENT.md.
JWT_SECRET=cambiar-esta-clave-en-produccion

# ─── Uploads ───────────────────────────────────────────────
UPLOAD_DIR=./data/uploads

# ─── Admin Bootstrap ──────────────────────────────────────
# Contraseña para los admins por defecto: admin, daniel, pedro
# (debe cumplir: 8+ chars, 1 mayúscula, 1 minúscula, 1 número)
# Si no se configura, no se crean admins automáticamente. Production bootstrap
# passwords require 16+ chars with uppercase, lowercase, and a digit.
ADMIN_DEFAULT_PASSWORD=Admin123

# ─── Docente Bootstrap ───────────────────────────────────
# Contraseña temporal para usuarios docentes creados automáticamente
# al subir designaciones. Deben cambiarla en el primer login. The value below
# is development-only; production requires the stronger deployment policy.
DOCENTE_DEFAULT_PASSWORD=upds*2026

# ─── Business Settings ─────────────────────────────────────
# ACTIVE_ACADEMIC_PERIOD, COMPANY_NAME, COMPANY_NIT, HOURLY_RATE
# are now configured from the admin UI (Configuración page).
# Default values are seeded on first startup.

# ─── Email / Resend ─────────────────────────────────────────
# Disabled by default. Keep EMAIL_ENABLED=false unless Resend is configured.
# To enable in production, configure RESEND_API_KEY and a verified sender/domain.
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_API_URL=https://api.resend.com
EMAIL_TIMEOUT_SECONDS=3.0
EMAIL_TEST_MODE=false
EMAIL_TEST_RECIPIENT=

# ─── WhatsApp / Twilio Sandbox ─────────────────────────────
# Sandbox only: the sender must be Twilio's +14155238886 number and the test
# recipient must have joined the Sandbox. Never commit real credentials or
# phone numbers. API Key SID + Secret are used instead of the master Auth Token.
WHATSAPP_ENABLED=false
WHATSAPP_MODE=sandbox
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_SANDBOX_FROM=
TWILIO_WHATSAPP_SANDBOX_TEST_RECIPIENT=
TWILIO_API_BASE_URL=https://api.twilio.com
WHATSAPP_TIMEOUT_SECONDS=3.0
