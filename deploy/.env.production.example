# Compose identity and immutable release tag
COMPOSE_PROJECT_NAME=sipad
IMAGE_REGISTRY=local
IMAGE_TAG=<IMMUTABLE_RELEASE_TAG>
APP_HOST_PORT=<UNUSED_LOOPBACK_PORT>

# PostgreSQL (generate a unique high-entropy password; do not commit this file)
POSTGRES_DB=sipad
POSTGRES_USER=sipad
POSTGRES_PASSWORD=<MINIMUM_32_URI_SAFE_RANDOM_CHARACTERS>

# Application runtime
APP_ENV=production
AUTO_SCHEMA_BOOTSTRAP=false
CORS_ORIGINS=["https://<SIPAD_HOSTNAME>"]
JWT_SECRET=<MINIMUM_32_RANDOM_BYTES_64_HEX_CHARACTERS>
JWT_EXPIRE_MINUTES=480
UPLOAD_DIR=/app/backend/data/uploads

# Bootstrap passwords require 16+ characters with upper/lowercase and a digit.
# Leave ADMIN_DEFAULT_PASSWORD empty when an admin exists.
ADMIN_DEFAULT_PASSWORD=
DOCENTE_DEFAULT_PASSWORD=<GENERATE_A_UNIQUE_STRONG_TEMPORARY_PASSWORD>

# Outbound email stays disabled until the provider and sender are verified.
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_API_URL=https://api.resend.com
EMAIL_TIMEOUT_SECONDS=3.0
EMAIL_TEST_MODE=false
EMAIL_TEST_RECIPIENT=

# Runtime limits
BACKEND_WORKERS=2
BACKEND_MEMORY_LIMIT=1g
APP_MEMORY_LIMIT=256m
DB_MEMORY_LIMIT=1g
